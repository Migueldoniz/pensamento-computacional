# Armazenamento das salas.
#
# 1) LOCAL (padrão): sem variáveis, o app grava em ./.data/rooms.json.
#    Funciona em `npm run dev` / `npm start` na sua máquina.
#
# 2) UPSTASH (recomendado no Vercel): crie um Redis em https://upstash.com
#    e preencha as duas variáveis abaixo (também aceita KV_REST_API_URL/TOKEN
#    do Vercel KV).

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
